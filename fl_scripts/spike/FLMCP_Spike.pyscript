"""Phase 0 spike: which files may a piano roll script use?

No dialog on purpose. Without createDialog()/apply(), FL runs this file's
top-level code once per click (see FL's "Piano roll script reference.txt").
With a dialog, FL calls apply() again for live preview.

Tests reading, writing, renaming and deleting in three places:
  own_subdir:  Settings/Piano roll scripts/FLMCP Spike/  (created by check_phase0.py)
  own_folder:  Settings/Piano roll scripts/              (where this script lives)
  mailbox:     ~/.fl-mcp/                                (expected to be blocked)
Saves the report in the first place that accepts it, then shows a summary.
Imports only json, os, sys, time (see DECISIONS.md). Does not change any notes.

Throwaway: delete once DECISIONS.md records the result.
"""

import json
import os
import sys
import time

import flpianoroll as flp

HOME = os.path.expanduser("~")
OWN_FOLDER = os.path.join(HOME, "Documents", "Image-Line", "FL Studio", "Settings")
OWN_FOLDER = os.path.join(OWN_FOLDER, "Piano roll scripts")
FOLDERS = {
    "own_subdir": (os.path.join(OWN_FOLDER, "FLMCP Spike"), "spike_input.json"),
    "own_folder": (OWN_FOLDER, "FLMCP_spike_input.json"),
    "mailbox": (os.path.join(HOME, ".fl-mcp"), "spike_input.json"),
}

report = {
    "env": "pianoroll",
    "python": sys.version.split()[0],
    "ppq": flp.score.PPQ,
    "ops": {},
    "nonces": {},
}


def attempt(op, fn):
    try:
        fn()
        report["ops"][op] = "ok"
        return True
    except Exception as exc:
        report["ops"][op] = repr(exc)
        return False


def write_text(path, text):
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def read_nonce(label, path):
    def read():
        with open(path, encoding="utf-8") as f:
            report["nonces"][label] = json.load(f)["nonce"]

    attempt(label + ".read", read)


def probe_folder(label, folder):
    tmp = os.path.join(folder, "flmcp_probe.tmp")
    final = os.path.join(folder, "flmcp_probe.json")
    attempt(label + ".write", lambda: write_text(tmp, "{}"))
    replaced = attempt(label + ".replace", lambda: os.replace(tmp, final))
    attempt(label + ".remove", lambda: os.remove(final if replaced else tmp))


def probe_mkdir(folder):
    probe_dir = os.path.join(folder, f"flmcp_mkdir_probe_{time.time_ns()}")
    if attempt("own_folder.mkdir", lambda: os.mkdir(probe_dir)):
        attempt("own_folder.rmdir", lambda: os.rmdir(probe_dir))


def save_report():
    for label, (folder, _) in FOLDERS.items():
        path = os.path.join(folder, "spike_pianoroll.json")
        if attempt("save_report." + label, lambda p=path: write_text(p, json.dumps(report))):
            return path
    return None


try:
    for label, (folder, input_name) in FOLDERS.items():
        read_nonce(label, os.path.join(folder, input_name))
        probe_folder(label, folder)
    probe_mkdir(OWN_FOLDER)
except Exception as exc:
    report["spike_error"] = repr(exc)

saved_to = save_report()
summary = f"Report saved to {saved_to}" if saved_to else "Could not save the report anywhere"
lines = [summary] + [f"{op}: {'ok' if r == 'ok' else 'BLOCKED'}" for op, r in report["ops"].items()]
print("\n".join(lines))
flp.Utils.ShowMessage("\n".join(lines))
